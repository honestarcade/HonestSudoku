# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Gradle writes reports here; the root `/build/` pattern is anchored and misses it.
/android/build/

# Widget Preview related
.widget_preview/

# Signing — key material lives in ~/HonestArcadeApps/secrets/, never here.
# A keystore in this repository is a private key published to the world.
*.keystore
*.jks
*.p12
key.properties
*credentials*.txt
